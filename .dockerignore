# =============================================================
# .dockerignore — AWIS Repository Root
# Prevents unnecessary files from being sent to the Docker build
# context. Smaller context = faster builds and less data sent
# to the Docker daemon.
# =============================================================

# Python caches & compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (secrets — never bake into images)
.env
.env.local
.env.*.local

# Large training / data files (not needed at runtime)
ml_features.csv
tuning_results.json

# The SQLite database itself — runtime data lives in the Docker volume
awis.db
awis.db-shm
awis.db-wal

# Frontend node_modules and build output (rebuilt inside the container)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.eslintcache

# Git / IDE / OS
.git/
.gitattributes
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Test / development-only files
generate_appendix.py
er_diagram.puml
confusion_matrix.png
feature_importance.png

# NOTE: README.md, LICENSE, .gitignore, start scripts, Dockerfiles,
# docker-compose.yml, nginx.conf, requirements.txt are all intentionally
# included so the build context is complete.
