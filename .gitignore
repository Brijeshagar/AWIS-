# =============================================================
#  AWIS — .gitignore
# =============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── Environment files (real secrets — never commit) ──────────
.env
.env.local
.env.*.local

# ── SQLite runtime database files ────────────────────────────
awis.db
awis.db-shm
awis.db-wal

# ── Large training / ML artefacts (reproduced by train_model.py)
ml_features.csv
tuning_results.json

# ── Node / Frontend ──────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.eslintcache

# ── OS & editor artefacts ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Docker runtime ────────────────────────────────────────────
# (Docker files themselves ARE committed — only ignore runtime leftovers)

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Coverage / test reports ───────────────────────────────────
htmlcov/
.coverage
coverage.xml
*.cover

# ── Jupyter notebooks checkpoints ────────────────────────────
.ipynb_checkpoints/
