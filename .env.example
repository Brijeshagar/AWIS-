# =============================================================
#  AWIS — Environment Variables Example
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the real `.env` file — it is in .gitignore.
# =============================================================

# ── Backend ───────────────────────────────────────────────────

# Full path to the SQLite database file.
# In Docker this is set automatically to /app/data/awis.db (volume mount).
# In local dev, leave blank to use the default: ./awis.db (same folder as main.py)
DB_PATH=

# Uvicorn server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Frontend (Vite build-time variables) ─────────────────────

# The URL the browser uses to reach the FastAPI backend.
# In Docker (default): http://localhost:8000  (backend exposed on host port 8000)
# In local dev (default): http://127.0.0.1:8000
# In production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
