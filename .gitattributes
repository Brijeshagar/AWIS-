# =============================================================
#  AWIS — .gitattributes
#  Controls line endings to ensure scripts work cross-platform.
# =============================================================

# Default: auto-normalise all text files to LF in the repo
* text=auto eol=lf

# Shell scripts MUST have LF endings on checkout (otherwise
# they fail on Linux/macOS with "bad interpreter" errors).
*.sh text eol=lf

# Windows batch files should have CRLF on checkout.
*.bat text eol=crlf

# Binary files — never modify line endings
*.pkl binary
*.db  binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
